# For deployments with ephemeral filesystems, set DATA_DIR to a persistent volume.
NODE_ENV=production
APP_BASE_URL=https://your-deployed-domain.example
DATA_DIR=<absolute-path-to-persistent-data-directory>
SESSION_SECRET=<generate-a-long-random-secret>
ADMIN_EMAIL=admin@cspc.edu.ph
ADMIN_PASSWORD=<at-least-12-characters-for-first-production-start>
# Set true temporarily to reset an existing admin password on every app startup; change back to false after login works.
ADMIN_PASSWORD_RESET=false
ADMIN_NAME=CSPC Administrator
SMTP_HOST=<your-smtp-host>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<your-mailbox-address>
SMTP_PASS=<your-mailbox-password>
SMTP_FROM="Back2You <your-mailbox-address>"